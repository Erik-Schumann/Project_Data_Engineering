# Downloaded Kaggle datasets (large, licensed by Kaggle — not ours to redistribute).
# The bundled catalog-input/seed/seeds/*.csv are small, hand-authored fixture sets and ARE committed.
data/

__pycache__/
*.pyc
.DS_Store
.pytest_cache/

# client-input/state.py's local SQLite state, created when running the
# service or its tests outside Docker (STATE_DB_PATH defaults to
# "state.db" in the cwd) - inside Docker this lives on the client-input-state
# volume instead, never here.
state.db

.claude/*

.env
.claude/

# watch-summary is the one Gradle project in this repo - its own build
# output/cache, not source.
watch-summary/build/
watch-summary/.gradle/