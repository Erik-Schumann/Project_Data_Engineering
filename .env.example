COMPOSE_PROJECT_NAME=de-realtime

CONFLUENT_VERSION=7.6.1
POSTGRES_VERSION=16
GRAFANA_VERSION=11.1.0

KAFKA_PARTITIONS=4
# KRaft cluster ID (no Zookeeper) — fixed so `docker compose down -v && up`
# reliably recreates the same cluster identity. Generate your own with:
# docker run --rm confluentinc/cp-kafka:7.6.1 kafka-storage random-uuid
KAFKA_CLUSTER_ID=0--kxu-3ReGIutGCD2XS8g

CATALOG_DB_PORT=5432
CATALOG_DB_NAME=catalog
CATALOG_DB_USER=catalog
CATALOG_DB_PASSWORD=catalog

KAFKA_EXTERNAL_PORT=9092
SCHEMA_REGISTRY_PORT=8081
CONNECT_PORT=8083

# Catalog Admin frontend (Flask/Jinja/Bootstrap CRUD UI over catalog-db).
# Change these before running anywhere other than your own machine.
FRONTEND_PORT=5000
FRONTEND_ADMIN_USERNAME=admin
FRONTEND_ADMIN_PASSWORD=changeme
FRONTEND_SECRET_KEY=change-this-to-a-random-value

# Client Input Service (synthetic watch/rating event generator + status
# dashboard). Auth vars mirror FRONTEND_* above - same pattern, separate
# credentials/port. Change before running anywhere other than your own machine.
#
# client-input-db: a dedicated MySQL, not another Postgres - CDC source for
# this service's own ratings/watch_events (mirrors catalog-db's role for
# Item/User), chosen deliberately as a different engine - see
# client-input/README.md. Credentials also hardcoded directly in
# client-input/connect/*.json and client-input/mysql/init/02-grants.sql
# (same convention as catalog-source-connector.json) - changing these here
# alone does NOT change what the connectors/generator.py connect with.
MYSQL_VERSION=8.0
CLIENT_INPUT_DB_PORT=3307
CLIENT_INPUT_DB_NAME=client_input
CLIENT_INPUT_DB_USER=client_input
CLIENT_INPUT_DB_PASSWORD=changeme
CLIENT_INPUT_DB_ROOT_PASSWORD=changeme
CLIENT_INPUT_PORT=5001
CLIENT_INPUT_ADMIN_USERNAME=admin
CLIENT_INPUT_ADMIN_PASSWORD=changeme
CLIENT_INPUT_SECRET_KEY=change-this-to-a-random-value
# Generator pacing - defaults also baked into generator.py. Initial values
# only - these seed the SQLite control table on first start. After that,
# the dashboard's "Generator tuning" form is the live source of truth
# (persisted in the client-input-state volume), so changing these later has
# no effect on an existing state.db.
#
# TICK_SECONDS is NOT here - it's a fixed constant in generator.py (5s), not
# runtime-tunable: watch-summary-service's SESSION_GAP_SECONDS below depends
# on the heartbeat cadence staying put, so it was pulled from the tunable
# set entirely rather than just documented as risky to change.
SIMULATION_SPEED=45
ARRIVAL_PROBABILITY=0.6
MAX_ARRIVALS_PER_TICK=3
SESSION_MAX_ITEMS=20
RATING_PROBABILITY=0.7
ABANDON_PROBABILITY=0.25

# watch-summary-service (Kafka Streams - see watch-summary/README.md).
# Session-windows de.iu.Watch.Event.V002's heartbeats on this many seconds
# of inactivity before treating a watch as settled and republishing it to
# de.iu.Watch.Summary.V002. Coupled to client-input's fixed 5s heartbeat
# cadence (TICK_SECONDS is no longer configurable, see generator.py) -
# needs to stay comfortably more than 2x that cadence, or the job will see
# false "abandoned" summaries mid-watch. Not meant to change independently.
SESSION_GAP_SECONDS=10

# Reporting Output Service (JDBC sink connectors -> reporting-db -> Grafana).
# reporting-db credentials are also hardcoded directly in
# reporting-output/connect/*.json and the Grafana datasource YAML (same
# convention as catalog-source-connector.json) - changing these here alone
# does NOT change what the connectors/Grafana connect with.
REPORTING_DB_PORT=5433
REPORTING_DB_NAME=reporting
REPORTING_DB_USER=reporting
REPORTING_DB_PASSWORD=reporting

GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme

# Reporting Output Service — all ten jobs below are plain scheduled SQL
# against reporting-db (psycopg2, no Application UI ports) — see
# reporting-output/README.md. Orphaned Rating/Watch.Event
# cleanup (item/user deleted after the fact) also ran here as
# stale-event-cleanup-service, 2026-08-10 through 2026-08-11, until
# client-input-db's FOREIGN KEY ... ON DELETE CASCADE took over that job
# at the source instead — see client-input/README.md.

# user-rating-avg: all-time avg rating per user, reporting-db.ratings ->
# reporting-db.user_rating_avg.
TRIGGER_INTERVAL_SECONDS=60

# item-rating-avg: all-time avg rating per item, reporting-db.ratings ->
# reporting-db.item_rating_avg. Shares TRIGGER_INTERVAL_SECONDS above.

# trending-rankings: top TRENDING_TOP_N movies/series by view count and by
# rating, over a rolling last-TRENDING_WINDOW_MINUTES window -> reporting-db.
TRENDING_WINDOW_MINUTES=10
TRENDING_TOP_N=10

# user-mood: good/average/bad per user from the average of their last 3
# ratings, reporting-db.ratings -> reporting-db.user_mood. Shares
# TRIGGER_INTERVAL_SECONDS above.

# user-series-movie-ratio: all-time series vs movie watch-event counts per
# user, reporting-db.watch_events -> reporting-db.

# item-completion-rate: all-time completion rate per item (movie or
# series), reporting-db.watch_events -> reporting-db.

# user-top-genre: each user's most-watched genre_primary over their last
# USER_TOP_GENRE_RECENT_N watches (a recency rank, not a time window,
# same pattern as user-mood's "last 3 ratings") -> reporting-db.
USER_TOP_GENRE_RECENT_N=8

# user-watch-count: distinct items watched + total watches (rewatches
# included) per user, reporting-db.watch_events -> reporting-db. Shares
# TRIGGER_INTERVAL_SECONDS above.

# user-top-device-language: each user's most-used device + most-watched
# original language, all-time (frequency, tie-broken by most recent
# watch) -> reporting-db. Shares TRIGGER_INTERVAL_SECONDS above.

# item-viewer-demographics: each item's average viewer age + male/female/
# other/unknown sex distribution, from distinct viewers (not raw watch
# events - see its README) -> reporting-db. Shares TRIGGER_INTERVAL_SECONDS
# above.

# Free community-edition license for kPow (https://kpow.io/get-started/) -
# kpow is part of the default stack (not profile-gated). Copy this file to
# .env and fill in your own values (.env is gitignored, .env.example is not).
KPOW_LICENSE_ID=
KPOW_LICENSE_CODE=COMMUNITY
KPOW_LICENSEE=
KPOW_LICENSE_EXPIRY=
KPOW_LICENSE_SIGNATURE=
